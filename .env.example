# Postgres (Neon). Tables live in the `latent` schema; drizzle-kit is fenced to it.
DATABASE_URL=

# Anthropic API key: match explanations (sonnet, streaming) and latent_line
# generation at seed time (opus). Without it the match degrades to keyword
# matching over the same profile data.
ANTHROPIC_API_KEY=

# Auth.js secret. Generate with: openssl rand -base64 32. Only /claim is authenticated.
AUTH_SECRET=

# GitHub OAuth app (callback: https://<deploy>/api/auth/callback/github).
# Used ONLY for the claim flow.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Raises GitHub API rate limits for public-profile generation at seed time.
# Public data only.
GITHUB_PAT=
