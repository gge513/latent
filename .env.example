# Postgres (Neon). Tables live in the `latent` schema; drizzle-kit is fenced to it.
DATABASE_URL=

# Anthropic API key: match explanations (sonnet, streaming) and latent_line
# generation at seed time (opus). Without it the match degrades to keyword
# matching over the same profile data.
ANTHROPIC_API_KEY=

# Auth.js secret. Generate with: openssl rand -base64 32. Only /claim is authenticated.
AUTH_SECRET=

# GitHub OAuth app (callback: https://<deploy>/api/auth/callback/github).
# Used ONLY for the claim flow.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Raises GitHub API rate limits for public-profile generation at seed time.
# Public data only.
GITHUB_PAT=

# PostHog project key. Mirrors the /proof aggregate counts so they can be read
# as trends. Server-side only, one constant identity, no visitor data. Leave it
# empty and the mirror is a no-op, which is what local dev and CI want.
POSTHOG_KEY=
# Optional. Defaults to https://us.i.posthog.com.
POSTHOG_HOST=

# Where an introduction request is addressed on /partners. Optional: unset,
# the form still composes the message and simply offers no mail door. Never
# hardcode an address in source as a fallback.
INTRO_EMAIL=
